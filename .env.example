# ===============================================
# 🤖 BOT CONTROLLER CONFIGURAÇÕES (Telegram Bot API)
# ===============================================
# Token do Bot obtido com o @BotFather
BOT_TOKEN=SEU_BOT_TOKEN_AQUI

# IDs dos usuários autorizados a interagir com o bot (separados por vírgula)
# Exemplo: AUTHORIZED_USERS=123456789,987654321
AUTHORIZED_USERS=123456789

# ===============================================
# 👤 USERBOT TELETHON CONFIGURAÇÕES (MTProto / Conta de Usuário)
# ===============================================
# Credenciais da API obtidas em https://my.telegram.org
API_ID=123456
API_HASH=SEU_API_HASH_AQUI

# Número de telefone da conta do Telegram com código do país (+55...)
PHONE_NUMBER=+5511999999999

# Senha de verificação em duas etapas (2FA), se habilitada
SENHA_2FA=SUA_SENHA_2FA_AQUI

# ===============================================
# ⚙️ CONFIGURAÇÕES GERAIS E ARQUIVOS
# ===============================================
# Delay padrão de fallback (em segundos)
APPROVE_DELAY=1.0

# 🛡️ MOTOR ANTI-SPAM (Perfis: balanced, fast, stealth)
# balanced = 1.2s a 2.8s (Recomendado/Padrão)
# fast = 0.8s a 1.5s
# stealth = 2.5s a 5.0s
ANTI_SPAM_MODE=balanced
ANTI_SPAM_MIN_DELAY=1.2
ANTI_SPAM_MAX_DELAY=2.8

# Arquivos de dados
SESSION_FILE=conta.session
CONFIG_FILE=bot_config.json
LOGS_FILE=bot_logs.json
